    {
      "parameters": {
        "jsCode": "const items = $input.all();\nreturn items.map(i => {\n  const item = i.json;\n  let body = item.text || item.snippet || '';\n  const cutMarkers = [/\\n>/, /\\nOn .* wrote:/i, /\\n-{2,}\\s*Original Message\\s*-{2,}/i];\n  for (const marker of cutMarkers) {\n    const idx = body.search(marker);\n    if (idx !== -1) { body = body.slice(0, idx); }\n  }\n  body = body.trim();\n  return {\n    json: {\n      messageId: item.id,\n      threadId: item.threadId,\n      from: item.from,\n      subject: item.subject,\n      body\n    }\n  };\n});"
      },
      "id": "3f6605be-c81b-4967-9093-0d90c34f0a25",
      "name": "Extract & Clean Email Content",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        208
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Customer email subject: {{ $json.subject }}\nFrom: {{ $json.from }}\n\nCustomer message:\n{{ $json.body }}",
        "options": {
          "systemMessage": "You are a customer support assistant for Veltoro, an online fashion retailer. Before answering, always call the 'Veltoro Knowledge Base' tool to search company policy documents relevant to the customer's question (shipping, returns, payments, sizing, warranty, account help, escalation). Base your answer strictly on the retrieved knowledge base content and the customer's message. Do not invent policies or details that are not present in the retrieved context. Write the reply as a complete, ready-to-send email body: a polite greeting, a direct answer to the question, relevant policy details from the knowledge base, and a professional sign-off from 'Veltoro Customer Support'. Do not include a subject line. If the knowledge base has no relevant information, say a human support agent will follow up, and do not guess."
        }
      },
      "id": "0dba3b0b-9c2f-4c86-a2d3-a5f414e94f35",
      "name": "Draft Support Reply (RAG Agent)",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        480,
