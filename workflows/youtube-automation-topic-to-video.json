    {
      "parameters": {
        "jsCode": "const images = $('Check Image Source').all().map(item => item.json.data.attributes.source);\nconst audioAttrs = $('Check Audio Source').first().json.data.attributes;\nconst audioUrl = audioAttrs.source;\nconst audioDuration = audioAttrs.duration || 30;\nconst outroLength = 2.5;\nconst minLength = 30;\nconst totalLength = Math.max(minLength, Math.round((audioDuration + outroLength) * 10) / 10);\nconst title = $('Video Details').first().json.title;\n\nconst clipLength = Math.round((totalLength / images.length) * 10) / 10;\nconst effects = ['zoomIn', 'zoomOut', 'slideLeft', 'slideRight'];\n\nconst imageClips = images.map((url, i) => ({\n  asset: { type: 'image', src: url },\n  start: Math.round(i * clipLength * 10) / 10,\n  length: clipLength,\n  fit: 'crop',\n  effect: effects[i % effects.length],\n  transition: { in: 'fade', out: 'fade' }\n}));\n\nconst payload = {\n  timeline: {\n    background: '#000000',\n    tracks: [\n      {\n        clips: [\n          { asset: { type: 'title', text: title, style: 'minimal', color: '#ffffff', size: 'x-small', position: 'center' }, start: 0, length: 3, transition: { in: 'fade', out: 'fade' } },\n          { asset: { type: 'title', text: 'Follow for more!', style: 'minimal', color: '#ffffff', size: 'x-small', position: 'bottom' }, start: totalLength - outroLength, length: outroLength, transition: { in: 'fade', out: 'fade' } }\n        ]\n      },\n      { clips: imageClips },\n      { clips: [ { asset: { type: 'audio', src: audioUrl }, start: 0, length: totalLength } ] }\n    ]\n  },\n  output: { format: 'mp4', resolution: 'sd', aspectRatio: '9:16' }\n};\n\nreturn [{ json: payload }];"
      },
