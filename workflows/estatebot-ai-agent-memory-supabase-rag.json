    {
      "parameters": {
        "jsCode": "const output = $input.first().json.output || \"\";\n\nconst match = output.match(/LEAD_COMPLETE:\\s*(\\{[\\s\\S]*\\})/);\n\nif (!match) {\n  throw new Error(\"LEAD_COMPLETE JSON not found in AI output\");\n}\n\nlet lead;\n\ntry {\n  lead = JSON.parse(match[1]);\n} catch (error) {\n  throw new Error(\"Invalid LEAD_COMPLETE JSON: \" + error.message);\n}\n\nreturn [\n  {\n    json: {\n      timestamp: new Date().toISOString(),\n      name: lead.name || \"\",\n      phone: lead.phone || \"\",\n      budget: lead.budget || \"\",\n      location: lead.location || \"\",\n      property_type: lead.property_type || \"\",\n      timeline: lead.timeline || \"\",\n      chat_id: lead.chat_id || \"\",\n      status: \"Qualified\"\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
